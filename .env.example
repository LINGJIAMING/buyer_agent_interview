# 本地微调模型（python cli.py）
MODEL_ID=/path/to/Qwen2.5-7B-Instruct
ADAPTER_PATH=/path/to/lora_checkpoint
DEVICE_DTYPE=bfloat16

# 远程 API（python cli_api.py，在 cli_api.py 顶部也可直接填 Key）
# DEEPSEEK_API_KEY=your-deepseek-key

# 可选
ENABLE_QUERY_OPTIMIZER=true
ENABLE_BUSINESS_API=true
BUSINESS_API_MODE=mock
ENABLE_SOP_RAG=true
RAG_BM25_ONLY=true
RAG_USE_RERANK=false
RAG_SOP_TOP_K=3
# RAG_SOURCE_DIR=/path/to/sop_raw
# EMBEDDING_MODEL_PATH=/path/to/bge-small-zh-v1.5
